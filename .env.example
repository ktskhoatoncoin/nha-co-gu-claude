# Supabase (required once the data layer is migrated off static seed data —
# see README.md "Chuyển sang Supabase"). Safe to leave blank for the V1 demo,
# which runs entirely on lib/data/*.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo-only password gate for /admin (see components/admin/AdminGate.tsx).
# NOT secure — replace with Supabase Auth + middleware before going live.
NEXT_PUBLIC_ADMIN_DEMO_PASSWORD=nhacogu-admin

# Public site URL, used in metadata, sitemap.ts and robots.ts.
NEXT_PUBLIC_SITE_URL=https://nhacogu.vn
